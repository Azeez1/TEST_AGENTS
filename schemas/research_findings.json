{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchFindings",
  "description": "Research-agent to copywriter handoff. Contains researched data, statistics, and talking points for content creation.",
  "type": "object",
  "properties": {
    "status": {"type": "string", "enum": ["completed", "partial", "insufficient_data"]},
    "topic": {"type": "string"},
    "research_depth": {"type": "string", "enum": ["overview", "detailed", "comprehensive"]},
    "key_statistics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stat": {"type": "string"},
          "value": {"type": "string"},
          "source": {"type": "string"},
          "source_url": {"type": "string", "nullable": true},
          "date": {"type": "string", "nullable": true}
        },
        "required": ["stat", "value", "source"]
      }
    },
    "trends": {"type": "array", "items": {"type": "string"}},
    "audience_insights": {"type": "array", "items": {"type": "string"}, "nullable": true},
    "seo_opportunities": {
      "type": "object",
      "nullable": true,
      "properties": {
        "keywords": {"type": "array", "items": {"type": "string"}},
        "search_volume_estimates": {"type": "array", "items": {"type": "integer"}, "nullable": true},
        "difficulty_scores": {"type": "array", "items": {"type": "integer"}, "nullable": true}
      }
    },
    "talking_points": {"type": "array", "items": {"type": "string"}, "description": "Ready-to-use points for the copywriter"},
    "proof_points": {"type": "array", "items": {"type": "string"}, "description": "Evidence and examples to support claims"},
    "sources_used": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "url": {"type": "string", "nullable": true},
          "relevance": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "required": ["title"]
      }
    }
  },
  "required": ["status", "topic", "key_statistics", "trends", "talking_points", "sources_used"]
}
