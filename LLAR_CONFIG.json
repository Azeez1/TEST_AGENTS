{
  "version": "1.0.0",
  "framework": "LLAR_1_12",
  "last_updated": "2026-03-15",
  "description": "Layered Language Agent Reasoning governance framework for 63-agent multi-team system",

  "routing": {
    "direct_llm": {
      "description": "Conceptual or text-only tasks requiring no tools",
      "examples": ["explain concept", "summarize text", "provide advice", "answer questions"],
      "route_to": "orchestrator_self"
    },
    "single_tool": {
      "description": "Tasks requiring exactly one tool invocation",
      "examples": ["send email", "create document", "generate image", "search web"],
      "route_to": "single_specialist"
    },
    "multi_tool_chain": {
      "description": "Tasks requiring multiple tools or sequential steps",
      "examples": ["create campaign", "build feature", "generate test suite", "process RFP"],
      "route_to": "multi_specialist_coordination"
    },
    "ask_user": {
      "description": "Missing required inputs that cannot be inferred",
      "examples": ["target audience undefined", "budget not specified", "timeline unclear"],
      "route_to": "user_clarification"
    }
  },

  "agent_rules": {
    "one_agent_one_role": true,
    "parallel_execution": {
      "enabled": true,
      "condition": "Independent extraction tasks with no data dependencies"
    },
    "sequential_execution": {
      "enabled": true,
      "condition": "Synthesis depends on prior outputs"
    }
  },

  "reflection": {
    "enabled": true,
    "checks": {
      "count": "Verify expected number of outputs produced",
      "atomicity": "Each output is independent and complete",
      "groundedness": "All claims traceable to source material",
      "uniqueness": "No duplicate outputs",
      "format": "Output matches expected schema/format",
      "hallucination": "No fabricated facts or citations",
      "error_transparency": "All errors logged to open_issues with structured error schema — no silent suppression"
    },
    "retry_limit": 2,
    "fallback_required": true,
    "fallback_actions": [
      "Log failure reason",
      "Attempt with simplified prompt",
      "Escalate to user if still failing"
    ]
  },

  "memory": {
    "store": {
      "preferences": "User preferences and defaults",
      "goals": "Long-term objectives and KPIs",
      "strategies": "Successful approaches and patterns",
      "constraints": "Boundaries and limitations",
      "traits": "Team-specific characteristics"
    },
    "ignore": {
      "temporary_tasks": "One-off requests not worth remembering",
      "rewrite_requests": "Iterative refinement requests",
      "ephemeral_details": "Context-specific details that expire"
    },
    "persistence": {
      "location": "{team}/memory/llar_memory.json",
      "update_trigger": "Task completion with learnings",
      "retention": "Indefinite for preferences/goals, 90 days for strategies"
    }
  },

  "case_facts": {
    "enabled": true,
    "schema": {
      "required_fields": ["workflow_id", "workflow_type", "current_stage", "completed_stages", "transactional_data", "open_issues", "constraints"],
      "transactional_data_fields": ["amounts", "dates", "identifiers", "counts"],
      "checkpoint_triggers": ["stage_completion", "agent_handoff", "error_recovery"]
    },
    "persistence": {
      "location": "{TEAM}/memory/active_workflows/{workflow_id}_case_facts.json",
      "survives_compaction": true,
      "cleanup_after_days": 30
    },
    "placement_rule": "Case facts block MUST be placed at the TOP of context (after agent definition), never in the middle. This counters the 'lost in the middle' effect."
  },

  "structured_errors": {
    "enabled": true,
    "schema": {
      "required_fields": ["error_id", "timestamp", "workflow_id", "source", "failure_type", "attempted_action", "partial_results", "alternatives", "escalation_level"],
      "failure_types": ["tool_failure", "validation_failure", "timeout", "hallucination_detected", "missing_input", "boundary_violation", "circuit_breaker_tripped"],
      "escalation_levels": ["team_orchestrator", "supervisor", "user"]
    },
    "logging": {
      "team_log": "{TEAM}/memory/error_log.json",
      "supervisor_log": ".claude/memory/supervisor_error_log.json",
      "max_entries": 50
    },
    "anti_patterns": [
      "NEVER use sentiment analysis as an escalation trigger",
      "NEVER use self-reported confidence scores for decisions",
      "NEVER silently suppress errors — always log to open_issues"
    ]
  },

  "evaluation": {
    "metrics": {
      "groundedness": {
        "description": "Claims traceable to sources",
        "threshold": 0.95
      },
      "hallucination_rate": {
        "description": "Rate of fabricated content",
        "threshold": 0.02
      },
      "accuracy": {
        "description": "Correctness of outputs",
        "threshold": 0.90
      },
      "precision": {
        "description": "Relevance of retrieved information",
        "threshold": 0.85
      },
      "recall": {
        "description": "Coverage of required information",
        "threshold": 0.80
      }
    },
    "enforce_thresholds": true
  },

  "tool_governance": {
    "enforce_schema": true,
    "retry_limit": 2,
    "circuit_breaker": {
      "enabled": true,
      "failure_threshold": 3,
      "reset_timeout_seconds": 300
    },
    "rate_limit": {
      "enabled": true,
      "requests_per_minute": 60
    },
    "boundary_violation_is_error": true,
    "priority_order": ["MCP", "Skill", "Custom Tool", "Create New"]
  },

  "governance_hierarchy": {
    "priority_order": [
      "permissions",
      "referee",
      "consensus",
      "voting",
      "orchestrator",
      "self_healing"
    ],
    "rules": {
      "authority_conflict": {
        "resolution": "permissions",
        "description": "When agents have conflicting authority levels, higher authority wins"
      },
      "fact_conflict": {
        "resolution": "referee",
        "description": "When agents disagree on facts, supervisor adjudicates"
      },
      "merge_valid_outputs": {
        "resolution": "consensus",
        "description": "When multiple valid outputs exist, merge them"
      },
      "select_one_output": {
        "resolution": "voting",
        "description": "When one output must be selected, use voting"
      },
      "workflow_ordering": {
        "resolution": "orchestrator",
        "description": "Orchestrator determines execution sequence"
      },
      "malfunction": {
        "resolution": "self_healing",
        "description": "Automatic retry with fallback on failures"
      }
    }
  },

  "team_orchestrators": {
    "ROOT": "supervisor",
    "MARKETING_TEAM": "router-agent",
    "QA_TEAM": "test-orchestrator",
    "ENGINEERING_TEAM": "cto",
    "PROPOSAL_TEAM": "rfp-agent",
    "FINANCIAL_TEAM": "cfo-agent",
    "SALES_TEAM": "sales-manager"
  },

  "escalation_paths": {
    "intra_team": "Team orchestrator handles",
    "cross_team": "Supervisor adjudicates",
    "unresolved": "Escalate to user",
    "triggers": {
      "transactional_data_drift": "Escalate when financial amounts change between stages without explicit justification in key_decisions",
      "coverage_regression": "Escalate when addressed requirement count decreases between pipeline stages"
    }
  }
}
