{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pinecone Metadata Schema for RFP Knowledge Base",
  "type": "object",
  "required": ["doc_id", "doc_type", "content_type"],
  "properties": {
    "doc_id": {
      "type": "string",
      "description": "Unique document identifier"
    },
    "doc_type": {
      "type": "string",
      "enum": [
        "resume",
        "past_performance",
        "case_study",
        "technical_writeup",
        "boilerplate",
        "company_info",
        "capability_statement",
        "certification",
        "other"
      ],
      "description": "Type of knowledge document"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "full_document",
        "section",
        "paragraph",
        "summary"
      ],
      "description": "Granularity of the indexed content"
    },
    "title": {
      "type": "string",
      "description": "Document or section title"
    },
    "author": {
      "type": "string",
      "description": "Author or subject (for resumes)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Document date or last updated"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable tags (skills, technologies, domains)"
    },
    "sector": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "government",
          "healthcare",
          "finance",
          "education",
          "energy",
          "transportation",
          "defense",
          "other"
        ]
      },
      "description": "Applicable industry sectors"
    },
    "classification": {
      "type": "string",
      "enum": ["public", "internal", "confidential"],
      "description": "Security classification"
    },
    "source_file": {
      "type": "string",
      "description": "Original filename"
    },
    "page_range": {
      "type": "string",
      "description": "Page range if applicable (e.g., '5-7')"
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Quality or relevance score"
    }
  }
}
