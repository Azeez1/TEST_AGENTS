{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QA Report Schema",
  "type": "object",
  "required": [
    "status",
    "coverage_percentage",
    "issues",
    "must_requirements_covered",
    "must_requirements_total",
    "summary"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["PASS", "WARNING", "FAIL"],
      "description": "Overall QA validation status"
    },
    "coverage_percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Percentage of requirements covered in proposal"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "category", "description", "location", "recommendation"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "WARNING", "INFO"],
            "description": "Issue severity level"
          },
          "category": {
            "type": "string",
            "enum": [
              "coverage",
              "placeholder",
              "broken_citation",
              "quality",
              "system",
              "missing_requirement",
              "formatting",
              "other"
            ],
            "description": "Issue category"
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "description": "Detailed description of the issue"
          },
          "location": {
            "type": "string",
            "description": "Where the issue was found (section name, requirement ID, etc.)"
          },
          "recommendation": {
            "type": "string",
            "description": "Suggested action to resolve the issue"
          },
          "requirement_id": {
            "type": "string",
            "pattern": "^R-[0-9]{3,}$",
            "description": "Related requirement ID (optional)"
          }
        }
      }
    },
    "must_requirements_covered": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of MUST/SHALL requirements addressed in proposal"
    },
    "must_requirements_total": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of MUST/SHALL requirements"
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "description": "Overall summary of QA results and recommendations"
    },
    "total_issues": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of issues found"
    },
    "critical_issues": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of critical issues found"
    },
    "warning_issues": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of warning-level issues found"
    },
    "info_issues": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of informational issues found"
    },
    "uncovered_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^R-[0-9]{3,}$"
      },
      "description": "List of requirement IDs not covered in proposal"
    },
    "validation_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When QA validation was performed"
    }
  }
}
