# RFP Proposal Team - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ===== LLM Provider Configuration =====
# Choose: "openai" or "anthropic"
LLM_PROVIDER=openai
LLM_MODEL_SMALL=gpt-4o-mini
LLM_MODEL_STRONG=gpt-4o

# OpenAI API Key (if using OpenAI)
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API Key (if using Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ===== Pinecone Vector Database (Primary RAG) =====
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENV=us-east-1
PINECONE_INDEX=rfp-knowledge-base
PINECONE_NAMESPACE=default

# ===== Embedding Configuration =====
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ===== Gemini File Search (Backup RAG System) =====
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_FILE_SEARCH_STORE=rfp-compliance-backup
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_TEMPERATURE=0.3
GEMINI_ENABLED=false

# ===== Logging =====
LOG_LEVEL=INFO
