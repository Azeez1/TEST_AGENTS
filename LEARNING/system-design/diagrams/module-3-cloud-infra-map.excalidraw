      "link": null,
      "locked": false,
      "text": "VM vs Container vs Serverless\nVM = full OS, heavy, most control\nContainer = shares host OS kernel (light/fast)\nServerless = function on-demand, cold start\nManage:  VM > Container > Serverless",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 13,
      "containerId": "KJKoHDY8DxxKd01SdXPk",
      "originalText": "VM vs Container vs Serverless\nVM = full OS, heavy, most control\nContainer = shares host OS kernel (light/fast)\nServerless = function on-demand, cold start\nManage:  VM > Container > Serverless",
      "lineHeight": 1.25,
      "autoResize": true
    },
