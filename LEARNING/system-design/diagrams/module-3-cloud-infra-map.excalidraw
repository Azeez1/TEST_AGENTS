      "isDeleted": false,
      "boundElements": [],
      "updated": 1783432038708,
      "link": null,
      "locked": false,
      "text": "Multi-Region = disaster recovery + global low latency\nFailover = auto-switch to healthy region\nRPO = data you can lose\nRTO = time to recover\ncost: cross-region = consistency + spend tradeoff",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 13,
      "containerId": "yyRL4fEPQfE7B8G9GI9f",
      "originalText": "Multi-Region = disaster recovery + global low latency\nFailover = auto-switch to healthy region\nRPO = data you can lose\nRTO = time to recover\ncost: cross-region = consistency + spend tradeoff",
      "lineHeight": 1.25,
      "autoResize": true
    },
