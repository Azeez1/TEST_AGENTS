      "link": null,
      "locked": false,
      "text": "Plan-and-execute = plan ALL steps upfront, execute\ncoherent, no wander, good for long defined tasks\nweakness: RIGID -> fix = re-plan hybrid",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 13,
      "containerId": "vdLzsHDbE0cvKN4lriQE",
      "originalText": "Plan-and-execute = plan ALL steps upfront, execute\ncoherent, no wander, good for long defined tasks\nweakness: RIGID -> fix = re-plan hybrid",
      "lineHeight": 1.25,
      "autoResize": true
    },
