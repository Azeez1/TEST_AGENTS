      "link": null,
      "locked": false,
      "text": "Loop termination = stop on goal, max iterations,\nbudget, no progress, or done signal\ndanger: false done or runaway cost\nrule: use hard backstops",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 13,
      "containerId": "uPI6FR19VouO88qOCANe",
      "originalText": "Loop termination = stop on goal, max iterations,\nbudget, no progress, or done signal\ndanger: false done or runaway cost\nrule: use hard backstops",
      "lineHeight": 1.25,
      "autoResize": true
    },
