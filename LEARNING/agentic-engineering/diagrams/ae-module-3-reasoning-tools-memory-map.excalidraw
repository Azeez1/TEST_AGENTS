      "locked": false,
      "text": "Action space = the set of actions an agent can take\ndesign = capability plus blast radius\nhigh-risk actions need gates and approvals",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 13,
      "containerId": "vwQua7LzYER0yCbIpu74",
      "originalText": "Action space = the set of actions an agent can take\ndesign = capability plus blast radius\nhigh-risk actions need gates and approvals",
      "lineHeight": 1.25,
      "autoResize": true
    },
