{
  "workspace": {
    "name": "TEST_AGENTS Root",
    "description": "Root-level supervisor workspace for cross-team quality assurance",
    "allowed_tools": [
      "bash",
      "read",
      "write",
      "edit",
      "glob",
      "grep",
      "task",
      "mcp__claude-in-chrome__*"
    ]
  },
  "skills": {
    "path": ".claude/skills",
    "description": "Shared skills available workspace-wide. Agents must explicitly declare skills in their definitions to use them.",
    "algorithmic-art": {
      "enabled": true
    },
    "artifacts-builder": {
      "enabled": true
    },
    "brand-guidelines": {
      "enabled": true
    },
    "canvas-design": {
      "enabled": true
    },
    "internal-comms": {
      "enabled": true
    },
    "mcp-builder": {
      "enabled": true
    },
    "skill-creator": {
      "enabled": true
    },
    "teach": {
      "enabled": true,
      "comment": "Stateful multi-session teaching workspace. Output routes to LEARNING/<topic-slug>/ (mattpocock/skills teach skill, adapted)"
    },
    "slack-gif-creator": {
      "enabled": true
    },
    "theme-factory": {
      "enabled": true
    },
    "filesystem": {
      "enabled": true,
      "userConfig": {
        "allowed_directories": [
          "C:\\",
          "C:\\Users"
        ]
      }
    },
    "figma": {
      "enabled": true
    },
    "flow-diagram": {
      "enabled": true
    },
    "excalidraw-diagrams": {
      "enabled": true,
      "comment": "Generates editable .excalidraw JSON files — no paid plan needed"
    },
    "pdf-filler": {
      "enabled": true
    },
    "pdf": {
      "enabled": true,
      "comment": "pypdf-based PDF creation - comprehensive features, offline capable"
    },
    "pptx": {
      "enabled": true,
      "comment": "html2pptx PowerPoint generation - no MCP alternative"
    },
    "docx": {
      "enabled": true,
      "comment": "Local Word document creation - use when offline or advanced features needed. Google Docs MCP is primary for cloud collaboration."
    },
    "xlsx": {
      "enabled": true,
      "comment": "Local Excel spreadsheet creation - use when offline or advanced features needed. Google Sheets MCP is primary for cloud collaboration."
    },
    "context7": {
      "enabled": true
    },
    "n8n-expression-syntax": {
      "enabled": true,
      "comment": "Auto-activates when writing {{}} expressions in n8n workflows"
    },
    "n8n-mcp-tools-expert": {
      "enabled": true,
      "comment": "Auto-activates for n8n-mcp tool usage - primary n8n skill"
    },
    "n8n-node-configuration": {
      "enabled": true,
      "comment": "Auto-activates for n8n node setup and property dependencies"
    },
    "n8n-validation-expert": {
      "enabled": true,
      "comment": "Auto-activates on n8n validation errors"
    },
    "n8n-workflow-patterns": {
      "enabled": true,
      "comment": "Provides 5 proven architectures from 2,653+ n8n templates"
    },
    "n8n-code-javascript": {
      "enabled": true,
      "comment": "Auto-activates for n8n Code node JavaScript"
    },
    "n8n-code-python": {
      "enabled": true,
      "comment": "Auto-activates for n8n Code node Python (rare)"
    }
  },
  "mcp": {
    "servers": {
      "supervisor-tools": {
        "command": "python3",
        "args": [
          ".claude/tools/supervisor_mcp_server.py"
        ],
        "description": "Supervisor verification and quality assurance tools"
      }
