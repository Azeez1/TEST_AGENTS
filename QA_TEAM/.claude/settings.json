{
  "description": "QA_TEAM settings - Testing-focused skills with read access to all teams for testing",
  "mcpServers": "inherit",
  "tools": {
    "allowed": [
      "bash",
      "read",
      "write",
      "edit",
      "glob",
      "grep",
      "task"
    ]
  },
  "skills": {
    "allowed": [
      "filesystem",
      "xlsx",
      "pdf",
      "docx"
    ],
    "comment": "Testing-focused skills only"
  },
  "workspace_access": {
    "description": "QA agents can READ all teams for testing, WRITE only to QA_TEAM",
    "read_paths": [
      "/home/user/TEST_AGENTS/MARKETING_TEAM",
      "/home/user/TEST_AGENTS/ENGINEERING_TEAM",
      "/home/user/TEST_AGENTS/FINANCIAL_TEAM",
      "/home/user/TEST_AGENTS/SALES_TEAM",
      "/home/user/TEST_AGENTS/PROPOSAL_TEAM",
      "/home/user/TEST_AGENTS/USER_STORY_AGENT"
    ],
    "write_paths": [
      "/home/user/TEST_AGENTS/QA_TEAM"
    ],
    "permissions": "read_all_write_own"
  }
}
